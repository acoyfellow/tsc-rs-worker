{
  "name": "tsc-rs-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Static files for the in-browser checker (the same .wasm, plus the ts-rust browser wrapper).
  // The Worker handles every path that is not a file here.
  "assets": { "directory": "./public" },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.html", "**/*.webmanifest", "**/*.txt"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  // 30 checks per minute per IP. Remove this block if your account has no rate limiting.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
  // To serve on your own domain, add for example:
  // "routes": [{ "pattern": "tsc-rs.example.com", "custom_domain": true }]
}
